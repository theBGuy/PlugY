// PlugY4Kolbot updater resources. Kept ASCII: rc.exe reads a BOM-less script in the ANSI code page.

#include <windows.h>
#include "../Commons/PlugYVersion.h"

#define IDI_PLUGYUPDATE 101

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_PLUGYUPDATE ICON "../PlugYRun/PlugY.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLUGY_VERSION_MAJOR,PLUGY_VERSION_MINOR,PLUGY_VERSION_PATCH,0
 PRODUCTVERSION PLUGY_VERSION_MAJOR,PLUGY_VERSION_MINOR,PLUGY_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "theBGuy"
			VALUE "FileDescription", "PlugY4Kolbot updater"
			VALUE "FileVersion", PLUGY_VERSION_FILE
			VALUE "InternalName", "PlugY4KolbotUpdater"
			VALUE "LegalCopyright", "Copyright (C) 2021 Yohann Nicolas; (C) 2026 theBGuy. GPLv3"
			VALUE "OriginalFilename", "PlugY4KolbotUpdater.exe"
			VALUE "ProductName", "PlugY4Kolbot"
			VALUE "ProductVersion", PLUGY_VERSION
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
